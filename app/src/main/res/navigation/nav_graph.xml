<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_workerDashboardFragment"
            app:destination="@id/workerDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_pendingApprovalFragment"
            app:destination="@id/pendingApprovalFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_pendingApprovalFragment"
            app:destination="@id/pendingApprovalFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/pendingApprovalFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.PendingApprovalFragment"
        android:label="Pending Approval"
        tools:layout="@layout/fragment_pending_approval" />

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_adminDashboardFragment_to_workersFragment"
            app:destination="@id/workersFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_pendingWorkersFragment"
            app:destination="@id/pendingWorkersFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_bulkWorkEntryFragment"
            app:destination="@id/bulkWorkEntryFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_reportsFragment"
            app:destination="@id/reportsFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/workersFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.WorkersFragment"
        android:label="Workers"
        tools:layout="@layout/fragment_workers" />

    <fragment
        android:id="@+id/pendingWorkersFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.PendingWorkersFragment"
        android:label="Pending Workers"
        tools:layout="@layout/fragment_pending_workers" />

    <fragment
        android:id="@+id/bulkWorkEntryFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.BulkWorkEntryFragment"
        android:label="Work Registration"
        tools:layout="@layout/fragment_bulk_work_entry" />

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.ReportsFragment"
        android:label="Reports"
        tools:layout="@layout/fragment_reports" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/workerDashboardFragment"
        android:name="com.hostwaypro.bigapp.ui.fragments.WorkerDashboardFragment"
        android:label="Worker Dashboard"
        tools:layout="@layout/fragment_worker_dashboard" />

</navigation>
